# =============================================================
# NexusGraph Backend - Environment Variables
# Copy to .env and fill in your credentials
# =============================================================

# --- Supabase (PostgreSQL + Storage) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJta2hra3Nzc2ZjeGpncm5waGlqIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzgyMzU4MjgsImV4cCI6MjA5MzgxMTgyOH0.wgr1zdmCrgOF7t9v8NJijkc_N1Z_hbpubGmQ8bzD1Fk
SUPABASE_SERVICE_KEY=your-service-role-key

# --- Neo4j AuraDB (Property Graph) ---
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your-aura-password

# --- Upstash Redis (API Cache) ---
UPSTASH_REDIS_URL=rediss://your-endpoint.upstash.io:6380
UPSTASH_REDIS_TOKEN=your-upstash-token

# --- Groq LLM (AI Briefings) ---
# Free tier at https://console.groq.com
GROQ_API_KEY=gsk_...
GROQ_MODEL=llama-3.1-8b-instant

# --- Dataset API Keys ---
# NOAA token used by the current NOAA ingester
# https://www.ncei.noaa.gov/support/access-data-service-api-user-documentation
DATA_GOV_IN_API_KEY=your-noaa-cdo-token

# OpenAQ Air Quality - https://docs.openaq.org/using-the-api/api-key
OPENAQ_API_KEY=your-openaq-key

# NASA Earthdata user token - https://urs.earthdata.nasa.gov
NASA_EARTHDATA_TOKEN=your-nasa-token

# IUCN Red List API account/token
# https://api.iucnredlist.org/users/sign_in
IUCN_API_TOKEN=your-iucn-token

# ACLED OAuth credentials - https://acleddata.com/oauth/token
ACLED_USERNAME=your-email@example.com
ACLED_PASSWORD=your-acled-password

# Legacy ACLED key flow, only if you still have old access
ACLED_API_KEY=

# --- App Config ---
ENVIRONMENT=development
SENTRY_DSN=https://your-sentry-dsn@sentry.io/123456
CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","https://nexusgraph.vercel.app"]
